# Copie para .env na raiz e preencha com seu banco de desenvolvimento.
# Caracteres especiais no usuário/senha devem estar codificados para URL.
# Exemplo: @ vira %40. Nunca publique o arquivo .env preenchido.
databaseUrl=postgresql://seuUsuario:suaSenha@127.0.0.1:5432/nexis_db

# Gere um valor aleatório com pelo menos 32 caracteres e não o versione.
authSecret=

# Origens adicionais só são necessárias quando frontend e API usam origens diferentes.
allowedOrigins=http://localhost:5173,http://127.0.0.1:5173
